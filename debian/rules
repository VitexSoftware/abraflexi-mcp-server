#!/usr/bin/make -f

export PYBUILD_NAME=abraflexi-mcp-server

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_clean:
	dh_auto_clean
	rm -rf build *.egg-info

override_dh_auto_install:
	dh_auto_install --destdir=debian/mcp-server-abraflexi
	# Install scripts
	install -d debian/mcp-server-abraflexi/usr/bin
	install -m 755 scripts/start_server.py debian/mcp-server-abraflexi/usr/bin/abraflexi-mcp-start
	install -m 755 scripts/test_server.py debian/mcp-server-abraflexi/usr/bin/abraflexi-mcp-test
	# Install example configuration
	install -d debian/mcp-server-abraflexi/usr/share/abraflexi-mcp-server
	install -m 644 .env.example debian/mcp-server-abraflexi/usr/share/abraflexi-mcp-server/
